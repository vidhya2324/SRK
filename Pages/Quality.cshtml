@page
@model SRKFruitsWeb.Pages.QualityModel
@{
    ViewData["Title"] = "Quality Standards";
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow reveal-up">Quality, Cleanliness &amp; Hygiene</p>
        <h1 class="reveal-up delay-1">SRK's Vendor Research &amp; Selection Process</h1>
        <p class="hero-lead reveal-up delay-2">
            SRK's vendor approval process is the key point for our success.
        </p>
    </div>
</section>

<section class="section">
    <div class="container process-grid">
        <div class="process-step reveal-up">
            <span class="process-num">01</span>
            <h3>Partner Selection</h3>
            <p>Partnering only with reputed domestic and international growers.</p>
        </div>
        <div class="process-step reveal-up delay-1">
            <span class="process-num">02</span>
            <h3>Quality Checks</h3>
            <p>Quality checks at source and on arrival, before any produce reaches the market.</p>
        </div>
        <div class="process-step reveal-up delay-2">
            <span class="process-num">03</span>
            <h3>Regulatory Compliance</h3>
            <p>Full compliance with food safety and import regulations (FSSAI).</p>
        </div>
        <div class="process-step reveal-up delay-3">
            <span class="process-num">04</span>
            <h3>Ethical Sourcing</h3>
            <p>Ethical sourcing and sustainable trade practices across our supplier network.</p>
        </div>
        <div class="process-step reveal-up delay-4">
            <span class="process-num">05</span>
            <h3>Continuous Evaluation</h3>
            <p>Ongoing evaluation of supplier performance to ensure consistency.</p>
        </div>
    </div>
</section>

<section class="section alt-bg">
    <div class="container">
        <div class="hygiene-grid">
            <div class="hygiene-copy reveal-left">
                <p class="eyebrow">Clean Handling, Every Stage</p>
                <h2>Quality, Cleanliness &amp; Hygiene</h2>
                <ul class="check-list">
                    <li>Clean handling at every stage</li>
                    <li>Proper grading &amp; packaging</li>
                    <li>Cold storage &amp; temperature control</li>
                    <li>Multi-stage quality inspection</li>
                    <li>Clean transport and market operations</li>
                </ul>
                <p class="note-callout">This ensures consistent quality, freshness, and reliability for every customer we serve.</p>
            </div>
            <div class="hygiene-media reveal-right">
                <div class="media-badge spin-slow media-badge-alt">
                    <span>FSSAI COMPLIANT</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <p class="eyebrow center reveal-up">Why Choose SRK Fruits India</p>
        <h2 class="center reveal-up">Six Reasons Retailers Trust Us</h2>

        <div class="reason-grid">
            <div class="reason-card reveal-up">
                <div class="reason-icon">30</div>
                <h3>Established Legacy</h3>
                <p>Trusted supplier since 1995.</p>
            </div>
            <div class="reason-card reveal-up delay-1">
                <div class="reason-icon">&#9989;</div>
                <h3>Qualified Leadership</h3>
                <p>Experienced, professionally qualified management team.</p>
            </div>
            <div class="reason-card reveal-up delay-2">
                <div class="reason-icon">&#127820;</div>
                <h3>Premium Offerings</h3>
                <p>Exotic and seasonal fruit range, sourced globally and locally.</p>
            </div>
            <div class="reason-card reveal-up delay-3">
                <div class="reason-icon">&#128737;</div>
                <h3>Strict Hygiene Control</h3>
                <p>FSSAI hygiene and quality-control standards applied throughout.</p>
            </div>
            <div class="reason-card reveal-up delay-4">
                <div class="reason-icon">&#129309;</div>
                <h3>Transparent Practices</h3>
                <p>Transparent and ethical business practices, always.</p>
            </div>
            <div class="reason-card reveal-up delay-5">
                <div class="reason-icon">&#128666;</div>
                <h3>Reliable Logistics</h3>
                <p>Dependable supply chain and cold-chain logistics.</p>
            </div>
        </div>
    </div>
</section>

<section class="section cta-section">
    <div class="container cta-inner reveal-up">
        <h2>Ready to work with a supplier you can trust?</h2>
        <p>Reach out and our team will walk you through availability, pricing and delivery.</p>
        <a asp-page="/Contact" class="btn btn-primary">Contact Our Team</a>
    </div>
</section>
