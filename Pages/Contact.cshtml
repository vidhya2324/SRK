@page
@model SRKFruitsWeb.Pages.ContactModel
@{
    ViewData["Title"] = "Contact Us";
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow reveal-up">Get In Touch</p>
        <h1 class="reveal-up delay-1">Let's Talk Fresh Produce</h1>
        <p class="hero-lead reveal-up delay-2">
            Whether you run a supermarket, a wholesale outlet, or need a reliable exotic-fruit
            supplier &mdash; our team responds fast.
        </p>
    </div>
</section>

<section class="section contact-section">
    <div class="container contact-grid">

        <div class="contact-info reveal-left">
            <div class="info-card">
                <span class="info-icon">&#128205;</span>
                <div>
                    <h3>Visit Us</h3>
                    <p>Shop No. TD 32, Anna Fruit Market,<br />Koyambedu, Chennai &ndash; 600017, Tamil Nadu</p>
                </div>
            </div>
            <div class="info-card">
                <span class="info-icon">&#128222;</span>
                <div>
                    <h3>Call Us</h3>
                    <p><a href="tel:+9184387 42508">+91 84387 42508</a></p>
                </div>
            </div>
            <div class="info-card">
                <span class="info-icon">&#9993;</span>
                <div>
                    <h3>Email Us</h3>
                    <p><a href="mailto:srkfreshfruits@gmail.com">srkfreshfruits@gmail.com</a></p>
                </div>
            </div>
  

            <div class="map-frame">
                <iframe
                    title="Anna Fruit Market, Koyambedu location map"
                    src="https://www.google.com/maps?q=Anna+Fruit+and+Vegetable+Market+Koyambedu+Chennai&output=embed"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>

        <div class="contact-form-wrap reveal-right">

            @if (Model.SubmissionSucceeded)
            {
                <div class="form-toast" role="status">
                    <span class="toast-icon">&#10003;</span>
                    <div>
                        <strong>Thank you, @Model.Form.FullName!</strong>
                        <p>Your enquiry has been received. Our team will get back to you shortly.</p>
                    </div>
                </div>
            }

            <form method="post" class="contact-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="form-summary-error"></div>

                <div class="form-row">
                    <label asp-for="Form.FullName"></label>
                    <input asp-for="Form.FullName" placeholder="e.g. Karthik Raja" autocomplete="name" />
                    <span asp-validation-for="Form.FullName" class="field-error"></span>
                </div>

                <div class="form-row form-row-split">
                    <div>
                        <label asp-for="Form.Email"></label>
                        <input asp-for="Form.Email" type="email" placeholder="you@company.com" autocomplete="email" />
                        <span asp-validation-for="Form.Email" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="Form.Phone"></label>
                        <input asp-for="Form.Phone" type="tel" placeholder="+91 90000 00000" autocomplete="tel" />
                        <span asp-validation-for="Form.Phone" class="field-error"></span>
                    </div>
                </div>

                <div class="form-row">
                    <label asp-for="Form.EnquiryType"></label>
                    <select asp-for="Form.EnquiryType">
                        <option value="">Select an option</option>
                        <option value="Wholesale Supply">Wholesale Supply</option>
                        <option value="Retail Partnership">Retail Partnership</option>
                        <option value="Exotic Fruit Order">Exotic Fruit Order</option>
                        <option value="Bulk / Institutional Order">Bulk / Institutional Order</option>
                        <option value="General Enquiry">General Enquiry</option>
                    </select>
                    <span asp-validation-for="Form.EnquiryType" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="Form.Message"></label>
                    <textarea asp-for="Form.Message" rows="5" placeholder="Tell us what you're looking for..."></textarea>
                    <span asp-validation-for="Form.Message" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block">
                    <span>Send Enquiry</span>
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
