@page
@model SRKFruitsWeb.Pages.ProductsModel
@{
    ViewData["Title"] = "Products";
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow reveal-up">What We Deal In</p>
        <h1 class="reveal-up delay-1">Exotic Imports &amp; Seasonal Favourites</h1>
        <p class="hero-lead reveal-up delay-2">
            All fruits are carefully graded, hygienically handled, and supplied under strict FSSAI quality standards.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <p class="eyebrow center reveal-up">Exotic &amp; Imported Fruits</p>
        <h2 class="center reveal-up">Global Orchards, Delivered Fresh</h2>

        <div class="product-grid">
            @foreach (var item in Model.ExoticFruits)
            {
                <div class="product-card reveal-up">
                    
                    <div class="product-image">
                        <img src="@item.ImageUrl" alt="@item.Name" />
                    </div>
                    <h3>@item.Name</h3>
                    @if (!string.IsNullOrEmpty(item.Note))
                    {
                        <span class="product-note">@item.Note</span>
                    }
                </div>
            }
        </div>
    </div>
</section>

<section class="section alt-bg">
    <div class="container">
        <p class="eyebrow center reveal-up">Seasonal Fruits</p>
        <h2 class="center reveal-up">Celebrating Local Favourites</h2>

        <div class="product-grid">
            @foreach (var item in Model.SeasonalFruits)
            {
                <div class="product-card reveal-up">
                    
                    <div class="product-image">
                        <img src="@item.ImageUrl" alt="@item.Name" />
                    </div>
                    <h3>@item.Name</h3>
                    @if (!string.IsNullOrEmpty(item.Note))
                    {
                        <span class="product-note">@item.Note</span>
                    }
                </div>
            }
        </div>
    </div>
</section>

<section class="section cta-section">
    <div class="container cta-inner reveal-up">
        <h2>Interested in a specific fruit or bulk order?</h2>
        <p>Tell us what you're looking for and we'll get back with availability and pricing.</p>
        <a asp-page="/Contact" class="btn btn-primary">Request a Quote</a>
    </div>
</section>
